---
import { render } from 'astro:content';
import {
  type Note,
  allTags,
  groupByMonth,
  hasTag,
  href,
  isShort,
  isoDate,
  listHref,
  noteHref,
  pageCount,
  pageOf,
  readingMinutes,
  shortDate,
  tagHref,
} from '../lib/notes';
import { UI, entries, matches, minutes, pagePosition } from '../lib/i18n';

interface Props {
  notes: Note[]; // every published note, newest first
  tag?: string; // when set, only notes with this tag are listed
  page?: number; // which page of the list, from 1 (PAGE_SIZE notes a page, see site.ts)
}

const { notes, tag, page = 1 } = Astro.props;
const tags = allTags(notes);
const shown = tag ? notes.filter((n) => hasTag(n, tag)) : notes;
const pages = pageCount(shown.length);
const onPage = pageOf(shown, page);
const groups = groupByMonth(onPage);

// Short notes are rendered in full on the index.
const bodies = new Map<string, Awaited<ReturnType<typeof render>>['Content']>();
for (const n of onPage) {
  if (isShort(n)) bodies.set(n.id, (await render(n)).Content);
}
---

<div class="index-bar">
  <nav class="tag-filter" aria-label={UI.filterLabel}>
    <a href={href()} aria-current={!tag ? 'page' : undefined}>{UI.all}</a>
    {tags.map((t) => (
      <a href={tagHref(t)} aria-current={t === tag ? 'page' : undefined}>{t === 'rough' ? UI.rough : t}</a>
    ))}
  </nav>
  <div
    class="find"
    data-find
    data-tag={tag}
    data-failed={UI.findFailed}
    data-match-one={matches(1)}
    data-match-many={matches(2).replace('2', '{n}')}
    data-rough={UI.rough}
    hidden
  >
    <label for="find">{UI.find}</label>
    <input id="find" type="search" placeholder={UI.findPlaceholder} autocomplete="off" />
  </div>
</div>

<p class="find-status" data-find-status role="status"></p>

<div data-listing>
{groups.map((g) => (
  <section class="month" data-month>
    <h2 class="label">{g.heading}</h2>
    {g.notes.map((n) => {
      const Body = bodies.get(n.id);
      const meta = [...n.data.tags];
      if (isShort(n)) meta.unshift(UI.shortNote);
      return (
        <article class={`row${isShort(n) ? ' row-short' : ''}`} data-row data-id={n.id}>
          {isShort(n) ? (
            <a class="row-date" href={noteHref(n)} title={UI.permalink}>
              <time datetime={isoDate(n.data.date)}>{shortDate(n.data.date)}</time>
            </a>
          ) : (
            <time class="row-date" datetime={isoDate(n.data.date)}>{shortDate(n.data.date)}</time>
          )}
          <div class="row-main">
            {isShort(n) && Body ? (
              <div class="prose prose-short">
                <Body />
              </div>
            ) : (
              <>
                <h3 class="row-title">
                  <a href={noteHref(n)}>{n.data.title}</a>
                </h3>
                {n.data.summary && <p class="row-summary">{n.data.summary}</p>}
              </>
            )}
            <p class="row-meta">
              {meta.join(' · ')}
              {n.data.rough && <>{meta.length > 0 && ' · '}<span class="rough">{UI.rough}</span></>}
              {!isShort(n) && <>{(meta.length > 0 || n.data.rough) && ' · '}{minutes(readingMinutes(n))}</>}
            </p>
          </div>
        </article>
      );
    })}
  </section>
))}

{shown.length === 0 && <p class="empty">{UI.empty}</p>}

{pages > 1 && (
  <nav class="pager" aria-label={UI.pagesLabel}>
    {page > 1 ? <a href={listHref(page - 1, tag)} rel="prev">{UI.newer}</a> : <span />}
    <span class="pager-at" aria-current="page">{pagePosition(page, pages)}</span>
    {page < pages ? <a href={listHref(page + 1, tag)} rel="next">{UI.older}</a> : <span />}
  </nav>
)}
</div>

<div data-results hidden></div>

<footer class="index-foot">
  <span>
    {entries(shown.length)}
    {notes[0] && <> · {UI.lastWritten} {isoDate(notes[0].data.date)}</>}
  </span>
  <a href={href('rss.xml')}>{UI.subscribe}</a>
</footer>

<script>
  // Progressive enhancement: the find box only appears when JS runs. The list is split into
  // pages, so a search runs over search.json (every note) and its matches replace the page.
  // If search.json can't be loaded, it falls back to filtering the rows on this page.
  interface Entry {
    id: string;
    href: string;
    title: string;
    summary: string;
    date: string;
    day: string;
    month: string;
    tags: string[];
    rough: boolean;
    meta: string;
    minutes: string;
    text: string;
  }

  const box = document.querySelector<HTMLElement>('[data-find]');
  const input = document.querySelector<HTMLInputElement>('#find');
  const status = document.querySelector<HTMLElement>('[data-find-status]');
  const listing = document.querySelector<HTMLElement>('[data-listing]');
  const results = document.querySelector<HTMLElement>('[data-results]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
  const months = [...document.querySelectorAll<HTMLElement>('[data-month]')];

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  };

  /** A row like the server-rendered ones, with the title (or a short note's first words) linked. */
  const row = (n: Entry) => {
    const article = el('article', 'row');
    const time = el('time', 'row-date', n.day);
    time.dateTime = n.date;
    const main = el('div', 'row-main');
    const h = el('h3', 'row-title');
    const a = el('a', undefined, n.title);
    a.href = n.href;
    h.append(a);
    main.append(h);
    if (n.summary) main.append(el('p', 'row-summary', n.summary));
    const meta = el('p', 'row-meta', n.meta);
    if (n.rough) {
      if (n.meta) meta.append(' · ');
      meta.append(el('span', 'rough', box?.dataset.rough));
    }
    if (n.minutes) meta.append(`${n.meta || n.rough ? ' · ' : ''}${n.minutes}`);
    main.append(meta);
    article.append(time, main);
    return article;
  };

  if (box && input && status && listing && results) {
    box.hidden = false;
    const scope = box.dataset.tag;
    let index: Entry[] | null = null;
    let loading: Promise<void> | null = null;

    const load = () =>
      (loading ??= fetch(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}search.json`)
        .then((r) => r.json())
        .then((data: Entry[]) => {
          index = scope
            ? data.filter((n) => (scope === 'rough' ? n.rough : n.tags.includes(scope)))
            : data;
        })
        .catch(() => {
          status.textContent = box.dataset.failed ?? '';
        }));

    const say = (terms: string[], hits: number) => {
      status.textContent = terms.length
        ? hits === 1
          ? (box.dataset.matchOne ?? '')
          : (box.dataset.matchMany ?? '').replace('{n}', String(hits))
        : '';
    };

    const apply = () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      if (!index) {
        // Fallback: filter this page's rows by their visible text.
        let hits = 0;
        for (const r of rows) {
          const match = terms.every((t) => (r.textContent?.toLowerCase() ?? '').includes(t));
          r.hidden = !match;
          if (match) hits++;
        }
        for (const m of months) m.hidden = !m.querySelector('[data-row]:not([hidden])');
        say(terms, hits);
        return;
      }
      results.replaceChildren();
      const searching = terms.length > 0;
      listing.hidden = searching;
      results.hidden = !searching;
      if (!searching) return say(terms, 0);
      const found = index.filter((n) => terms.every((t) => n.text.includes(t)));
      let section: HTMLElement | null = null;
      for (const n of found) {
        if (section?.dataset.month !== n.month) {
          section = el('section', 'month');
          section.dataset.month = n.month;
          section.append(el('h2', 'label', n.month));
          results.append(section);
        }
        section.append(row(n));
      }
      say(terms, found.length);
    };

    let timer: number | undefined;
    input.addEventListener('focus', load, { once: true });
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => load().then(apply), 100);
    });
  }
</script>
