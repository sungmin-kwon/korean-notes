---
// Pages 2, 3, … of the index. Page 1 is the index itself (pages/index.astro).
import IndexPage from '../../components/IndexPage.astro';
import { getNotes, pageCount } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  const pages = pageCount(notes.length);
  return Array.from({ length: pages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2 },
  }));
}

const { page } = Astro.props;
---

<IndexPage page={page} />
