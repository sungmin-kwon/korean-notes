---
// First page of a tag's list. Later pages are in tags/[tag]/page/[page].astro.
import TagPage from '../../components/TagPage.astro';
import { allTags, getNotes, tagSlug } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  return allTags(notes).map((tag) => ({ params: { tag: tagSlug(tag) }, props: { tag } }));
}

const { tag } = Astro.props;
---

<TagPage tag={tag} page={1} />
