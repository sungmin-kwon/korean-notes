---
import Base from '../../layouts/Base.astro';
import NoteIndex from '../../components/NoteIndex.astro';
import { allTags, getNotes, tagInfo, tagSlug } from '../../lib/notes';
import { UI } from '../../lib/i18n';

export async function getStaticPaths() {
  const notes = await getNotes();
  return allTags(notes).map((tag) => ({ params: { tag: tagSlug(tag) }, props: { tag } }));
}

const { tag } = Astro.props;
const notes = await getNotes();
const info = tagInfo(tag);
const description = info
  ? `${info.description}`
  : tag === 'rough'
    ? UI.roughTagDescription
    : UI.tagDescription.replace('{tag}', tag);
const name = tag === 'rough' ? UI.rough : tag;
---

<Base title={name} description={description}>
  <p class="intro">
    <span class="mono">{name}</span>{info?.era && <> · {info.era}</>}. {description}
  </p>
  <NoteIndex notes={notes} tag={tag} />
</Base>
