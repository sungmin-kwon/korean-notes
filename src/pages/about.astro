---
import Base from '../layouts/Base.astro';
import { href, tagHref } from '../lib/notes';
import { SITE_FAMILY, SITE_TITLE, TAGS } from '../lib/site';

// Edit this list whenever the focus shifts, and bump the date. It is not shown while empty.
// Each item: text before the link, the linked note's id and title, text after.
const currentlyUpdated = '2026-11-11';
const currently: { before: string; note: string; title: string; after: string }[] = [];

const others = SITE_FAMILY.filter((s) => s.title !== SITE_TITLE);
---

<Base title="소개" description="이 노트가 다루는 것, 태그, 그리고 이웃 노트." current="about">
  <article class="entry">
    <h1>소개</h1>
    <div class="prose">
      <!-- Placeholder text, to be replaced once the author decides how to introduce the notes. -->
      <p>
        근거이론과 실재론, 음악교육을 비롯해 여러 관심사를 정리한 노트입니다.
        오래 붙들어 온 질문과 개념을 나중에 다시 찾아볼 수 있도록 적어 둡니다.
      </p>
      <p>글은 다음 태그로 나뉩니다.</p>
      <ul class="eras">
        {TAGS.map((t) => (
          <li>{t.era && <><span class="label">{t.era}</span> </>}<a href={tagHref(t.name)}>{t.name}</a>: {t.blurb}</li>
        ))}
      </ul>
    </div>

    {currently.length > 0 && (
      <section class="about-block">
        <h2 class="label">요즘 · <time datetime={currentlyUpdated}>{currentlyUpdated}</time> 기준</h2>
        <ul>
          {currently.map((c) => (
            <li>{c.before}<a href={href(`notes/${c.note}/`)}>{c.title}</a>{c.after}</li>
          ))}
        </ul>
      </section>
    )}

    {others.length > 0 && (
      <section class="about-block">
        <h2 class="label">다른 노트</h2>
        <ul>
          {others.map((s) => (
            <li lang={s.lang && s.lang !== 'ko' ? s.lang : undefined}><a href={s.url}>{s.title}</a>: {s.blurb}</li>
          ))}
        </ul>
      </section>
    )}

    <section class="about-block about-block-quiet">
      <h2 class="label">읽는 법</h2>
      <p>
        <span class="rough">미완</span> 표시가 붙은 글은 덜 다듬은 생각이라 틀린 곳이 있을 수
        있습니다. 긴 글은 첫머리에 요지를 두었으니, 거기까지만 읽어도 됩니다.
      </p>
    </section>

    <p class="back"><a href={href()}>← 목록</a></p>
  </article>
</Base>
