---
import 'katex/dist/katex.min.css';
import '../styles/site.css';
import FamilyMenu from '../components/FamilyMenu.astro';
import { href } from '../lib/notes';
import { FONT_CSS, FONT_STYLESHEET, PALETTE_CSS, SITE_TITLE, SITE_DESCRIPTION, SITE_LANG } from '../lib/site';
import { UI, themeSwitch } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  current?: 'index' | 'about';
}

const {
  title,
  description = SITE_DESCRIPTION,
  current,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply a saved theme before first paint; otherwise the system setting applies.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    {PALETTE_CSS && <style is:inline set:html={PALETTE_CSS} />}
    {FONT_CSS && <style is:inline set:html={FONT_CSS} />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={href('rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONT_STYLESHEET} />
  </head>
  <body>
    <a class="skip" href="#main">{UI.skip}</a>
    <div class="page">
      <header class="masthead">
        <a class="site-name" href={href()} aria-current={current === 'index' ? 'page' : undefined}>
          {SITE_TITLE}
        </a>
        <nav aria-label={UI.navLabel}>
          <a href={href('about/')} aria-current={current === 'about' ? 'page' : undefined}>{UI.about}</a>
          <a href={href('rss.xml')}>{UI.rss}</a>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            data-name-light={UI.themeName.light}
            data-name-dark={UI.themeName.dark}
            data-label-light={themeSwitch('light')}
            data-label-dark={themeSwitch('dark')}
            hidden
          >{UI.themeName.dark}</button>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="colophon">
        <FamilyMenu />
      </footer>
    </div>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        var current = function () {
          return root.dataset.theme || (media.matches ? 'dark' : 'light');
        };
        var sync = function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          btn.textContent = btn.getAttribute('data-name-' + next);
          btn.setAttribute('aria-label', btn.getAttribute('data-label-' + next));
        };
        btn.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          sync();
        });
        media.addEventListener('change', sync);
        btn.hidden = false;
        sync();
      })();
    </script>
  </body>
</html>
